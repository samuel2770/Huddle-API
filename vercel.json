{
  "version": 2,
  "buildCommand": "npm run build",
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "frontend/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/auth/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/channels/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/workspaces/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/invites/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/hello",
      "dest": "/api/index.js"
    },
    {
      "src": "/signin",
      "dest": "/frontend/signin.html"
    },
    {
      "src": "/signup",
      "dest": "/frontend/signup.html"
    },
    {
      "src": "/dashboard",
      "dest": "/frontend/dashboard.html"
    },
    {
      "src": "/create-channel",
      "dest": "/frontend/create-channel.html"
    },
    {
      "src": "/channel-created",
      "dest": "/frontend/channel-created.html"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/frontend/assets/$1"
    },
    {
      "src": "/images/(.*)",
      "dest": "/frontend/images/$1"
    },
    {
      "src": "/css/(.*)",
      "dest": "/frontend/css/$1"
    },
    {
      "src": "/js/(.*)",
      "dest": "/frontend/js/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/$1"
    }
  ]
}
