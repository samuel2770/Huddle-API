# Application
PORT=3000
NODE_ENV=development
MESSAGE_EDIT_WINDOW_MINUTES=15

# PostgreSQL Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=huddle
DB_SYNCHRONIZE=true
DB_LOGGING=false

# Authentication & JWT
JWT_ACCESS_SECRET=your-access-secret-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-change-in-production
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Rate Limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=10
